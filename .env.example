# URL of the deployed SentinelWatch Cloudflare Worker (see worker/), which
# proxies AI diagnosis requests to Groq. Used for the AI diagnosis feature.
# Deploy with `cd worker && npm run deploy`, then paste the printed
# *.workers.dev URL here.
SENTINELWATCH_WORKER_URL=https://sentinelwatch-groq-proxy.your-subdomain.workers.dev
